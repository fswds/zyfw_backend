<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tiger.system.mapper.SysActivitySignNoticeMapper">
    
    <resultMap type="SysActivitySignNotice" id="SysActivitySignNoticeResult">
        <result property="noticeId"    column="notice_id"    />
        <result property="noticeTitle"    column="notice_title"    />
        <result property="noticeType"    column="notice_type"    />
        <result property="noticeContent"    column="notice_content"    />
        <result property="status"    column="status"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="signScore"    column="sign_score"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="extra"    column="extra"    />
        <result property="activityId"    column="activity_id"    />
    </resultMap>

    <sql id="selectSysActivitySignNoticeVo">
        select notice_id, notice_title, notice_type, notice_content, status, start_date, end_date, sign_score, update_time, create_time, extra, activity_id from sys_activity_sign_notice
    </sql>

    <select id="selectSysActivitySignNoticeList" parameterType="SysActivitySignNotice" resultMap="SysActivitySignNoticeResult">
        select sasn.notice_id, sasn.notice_title,
        sasn.notice_type,
        sasn.notice_content,
        sasn.status,
        sasn.start_date,
        sasn.end_date,
        sasn.sign_score,
        sasn.update_time,
        sasn.create_time,
        sasn.extra,
        sasn.activity_id,
        sa.name as activity_name
        from sys_activity_sign_notice sasn inner join sys_activity sa
        on sasn.activity_id = sa.id
        <where>  
            <if test="noticeTitle != null  and noticeTitle != ''"> and sasn.notice_title = #{noticeTitle}</if>
            <if test="noticeType != null  and noticeType != ''"> and sasn.notice_type = #{noticeType}</if>
            <if test="noticeContent != null  and noticeContent != ''"> and sasn.notice_content = #{noticeContent}</if>
            <if test="status != null  and status != ''"> and sasn.status = #{status}</if>
            <if test="startDate != null "> and sasn.start_date = #{startDate}</if>
            <if test="endDate != null "> and sasn.end_date = #{endDate}</if>
            <if test="signScore != null "> and sasn.sign_score = #{signScore}</if>
            <if test="extra != null  and extra != ''"> and extra = #{extra}</if>
            <if test="activityId != null "> and sasn.activity_id = #{activityId}</if>
            <if test="activityIdList !=null and activityIdList.size() > 0">
            and sasn.activity_id in
                <foreach item="item" collection="activityIdList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    
    <select id="selectSysActivitySignNoticeByNoticeId" parameterType="Integer" resultMap="SysActivitySignNoticeResult">
        select sasn.notice_id, sasn.notice_title,
               sasn.notice_type,
               sasn.notice_content,
               sasn.status,
               sasn.start_date,
               sasn.end_date,
               sasn.sign_score,
               sasn.update_time,
               sasn.create_time,
               sasn.extra,
               sasn.activity_id,
               sa.name as activity_name
        from sys_activity_sign_notice sasn inner join sys_activity sa
                                                      on sasn.activity_id = sa.id
        where sasn.notice_id = #{noticeId}
    </select>
        
    <insert id="insertSysActivitySignNotice" parameterType="SysActivitySignNotice" useGeneratedKeys="true" keyProperty="noticeId">
        insert into sys_activity_sign_notice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title,</if>
            <if test="noticeType != null and noticeType != ''">notice_type,</if>
            <if test="noticeContent != null">notice_content,</if>
            <if test="status != null">status,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="signScore != null">sign_score,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="extra != null">extra,</if>
            <if test="activityId != null">activity_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">#{noticeTitle},</if>
            <if test="noticeType != null and noticeType != ''">#{noticeType},</if>
            <if test="noticeContent != null">#{noticeContent},</if>
            <if test="status != null">#{status},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="signScore != null">#{signScore},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="extra != null">#{extra},</if>
            <if test="activityId != null">#{activityId},</if>
         </trim>
    </insert>

    <update id="updateSysActivitySignNotice" parameterType="SysActivitySignNotice">
        update sys_activity_sign_notice
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title = #{noticeTitle},</if>
            <if test="noticeType != null and noticeType != ''">notice_type = #{noticeType},</if>
            <if test="noticeContent != null">notice_content = #{noticeContent},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="signScore != null">sign_score = #{signScore},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="extra != null">extra = #{extra},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
        </trim>
        where notice_id = #{noticeId}
    </update>

    <delete id="deleteSysActivitySignNoticeByNoticeId" parameterType="Integer">
        delete from sys_activity_sign_notice where notice_id = #{noticeId}
    </delete>

    <delete id="deleteSysActivitySignNoticeByNoticeIds" parameterType="String">
        delete from sys_activity_sign_notice where notice_id in 
        <foreach item="noticeId" collection="array" open="(" separator="," close=")">
            #{noticeId}
        </foreach>
    </delete>
</mapper>